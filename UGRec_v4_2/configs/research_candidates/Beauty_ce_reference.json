{
  "data": {
    "dataset": "AmazonReviews2014",
    "category": "Beauty",
    "cache_dir": "cache/",
    "metadata": "sentence",
    "split": "leave_one_out",
    "max_item_seq_len": 50,
    "num_proc": 1,
    "sent_emb_model": "Qwen/Qwen3-Embedding-4B",
    "sent_emb_model_paths": {
      "Qwen/Qwen3-Embedding-4B": "cache/models/Qwen/Qwen3-Embedding-4B",
      "sentence-transformers/sentence-t5-base": "cache/models/sentence-transformers/sentence-t5-base"
    },
    "sent_emb_dim": 2560,
    "sent_emb_batch_size": 8,
    "sent_emb_max_length": 512,
    "sent_emb_dtype": "auto",
    "sent_emb_device": null,
    "sent_emb_local_files_only": true,
    "sent_emb_prompt": "",
    "sent_emb_normalize": true
  },
  "ae": {
    "architecture": "mlp",
    "hidden_dims": [
      512,
      256
    ],
    "latent_dim": 128,
    "lr": 0.0001,
    "weight_decay": 0.0001,
    "max_grad_norm": 1.0,
    "batch_size": 512,
    "update_every": 1,
    "frozen": false,
    "scheduler": "cosine",
    "warmup_ratio": 0.05,
    "cosine_weight": 0.1,
    "variance_weight": 0.1,
    "correlation_weight": 1.0,
    "relation_mode": "none",
    "relation_weight": 0.1,
    "relation_temperature": 0.1
  },
  "recommender": {
    "encoder_type": "transformer",
    "n_embd": 128,
    "n_layer": 2,
    "n_head": 4,
    "n_inner": 256,
    "activation_function": "gelu_new",
    "embd_pdrop": 0.1,
    "attn_pdrop": 0.1,
    "layer_norm_epsilon": 1e-06,
    "hstu_hidden_dim": 32,
    "hstu_attention_dim": 32,
    "hstu_use_group_norm": true,
    "hstu_output_dropout": 0.1,
    "hstu_attention_dropout": 0.0,
    "hstu_attention_scaling": "input_length",
    "diffloss_w": 256,
    "diffloss_d": 2,
    "num_sampling_steps": 20,
    "diffusion_batch_mul": 1,
    "diff_temperature": 1.0,
    "grad_checkpointing": false,
    "tiger_uncond_prob": 0.0,
    "tiger_guidance_weight": 0.0,
    "use_rectified_flow": true,
    "rectified_flow_steps": 1000,
    "ode_solver": "euler",
    "lr": 0.001,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "train_batch_size": 256,
    "update_every": 1,
    "scheduler": "cosine",
    "warmup_ratio": 0.1
  },
  "contrastive": {
    "enabled": false,
    "max_queries": 1024,
    "temperature": 0.04,
    "weight": 0.01,
    "num_negatives": 64
  },
  "ranking": {
    "enabled": true,
    "weight": 1.0,
    "rf_weight": 0.0,
    "local_weight": 0.1,
    "temperature": 0.07,
    "prediction_weight": 0.0,
    "endpoint_weight": 0.0,
    "rollout_weight": 0.0,
    "rollout_steps": 4,
    "prediction_min_time": 0.5,
    "teacher_weight": 0.0,
    "teacher_path": "",
    "teacher_dim": 128,
    "teacher_min_time": 0.5,
    "teacher_ae_grad": true,
    "history_ae_grad": true,
    "catalog_ae_grad": true,
    "prior_mode": "noise",
    "prior_noise": 0.3
  },
  "training": {
    "epochs": 40,
    "seed": 2024,
    "device": "auto",
    "run_id": "v4_1_content_ce_reference_s2024",
    "output_dir": "outputs/joint_training",
    "save_interval": 1,
    "deterministic": true,
    "num_workers": 0,
    "cpu_threads": 2,
    "smoke_test": false,
    "max_steps": null,
    "evaluate_test": false
  },
  "evaluation": {
    "eval_batched_retrieval": false,
    "prediction_source": "flow",
    "random_seed": 20261028,
    "eval_sampling_mode": "diffusion_multi",
    "eval_num_samples": 32,
    "eval_candidates_per_sample": 1,
    "eval_candidate_metric": "l2",
    "eval_candidate_ranking": "support",
    "eval_support_temperature": 1.0,
    "eval_log_sampling_stats": true,
    "topk": [
      5,
      10
    ],
    "metrics": [
      "recall",
      "ndcg"
    ],
    "val_metric": "ndcg@10",
    "eval_batch_size": 64,
    "eval_interval": 5,
    "patience": 20,
    "tiger_knn_metric": "cosine",
    "temperature": 0.07
  }
}
