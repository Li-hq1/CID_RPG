{
  "category": "Beauty",
  "cache_dir": "cache/",
  "metadata": "sentence",
  "split": "leave_one_out",
  "num_proc": 1,
  "max_item_seq_len": 50,
  "sent_emb_model": "sentence-transformers/sentence-t5-base",
  "sent_emb_model_paths": {
    "sentence-transformers/sentence-t5-base": "cache/models/sentence-transformers/sentence-t5-base"
  },
  "sent_emb_dim": 768,
  "sent_emb_pca": 128,
  "sent_emb_batch_size": 512,
  "supervision_mode": "all_positions",
  "n_embd": 512,
  "n_layer": 4,
  "n_head": 4,
  "n_inner": 1024,
  "activation_function": "gelu_new",
  "embd_pdrop": 0.1,
  "attn_pdrop": 0.1,
  "layer_norm_epsilon": 1e-12,
  "diffloss_w": 512,
  "diffloss_d": 3,
  "num_sampling_steps": 20,
  "diffusion_batch_mul": 1,
  "diff_temperature": 1.0,
  "grad_checkpointing": false,
  "tiger_uncond_prob": 0.1,
  "tiger_guidance_weight": 2.0,
  "use_rectified_flow": true,
  "rectified_flow_steps": 1000,
  "ode_solver": "euler",
  "temperature": 0.07,
  "tiger_knn_metric": "cosine",
  "lr": 0.0005,
  "epochs": 150,
  "weight_decay": 0.01,
  "train_batch_size": 256,
  "warmup_steps": 10000,
  "steps": null,
  "max_grad_norm": 1.0,
  "save_interval": 20,
  "eval_batch_size": 64,
  "eval_interval": 1,
  "patience": 20,
  "topk": [
    5,
    10
  ],
  "metrics": [
    "ndcg",
    "recall"
  ],
  "val_metric": "ndcg@10",
  "run_id": "tigerdiff_Beauty_all_positions",
  "ckpt_dir": "outputs/ckpt/",
  "rand_seed": 2024,
  "reproducibility": true,
  "model": "TigerDiff",
  "dataset": "AmazonReviews2014",
  "sent_emb_compression": "pca",
  "encoder_type": "transformer",
  "geometry_ae_cache": null
}
