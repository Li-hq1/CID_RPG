{
  "study_name": "beauty_hstu_epoch_lr",
  "n_trials": 40,
  "timeout": null,
  "direction": "maximize",
  "sampler": "tpe",
  "pruner": "none",
  "pruner_startup_trials": 5,
  "pruner_warmup_steps": 20,
  "enqueue_baseline": true,
  "parameters": [
    {"path": "recommender.n_layer", "type": "categorical", "choices": [1, 2, 3, 4]},
    {"path": "recommender.n_embd", "type": "categorical", "choices": [32, 64, 128, 256]},
    {"path": "recommender.n_head", "type": "categorical", "choices": [2, 4, 8]},
    {"path": "recommender.hstu_hidden_dim", "type": "categorical", "choices": [16, 32, 64, 128]},
    {"path": "recommender.hstu_attention_dim", "type": "categorical", "choices": [16, 32, 64, 128]},
    {"path": "training.epochs", "type": "int", "low": 30, "high": 120, "step": 10, "log": false},
    {"path": "recommender.lr", "type": "float", "low": 0.00001, "high": 0.002, "log": true}
  ]
}
